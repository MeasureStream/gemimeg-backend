  "measurementResults" : [
    {
      "name" : {
        "content" : [
          {
            "lang" : "de",
            "text" : "Messergebnisse"
          },
          {
            "lang" : "en",
            "text" : "Measurement results"
          }
        ]
      },
      "usedMethods" : [
        {
          "refTypes" : [
            "basic_uncertainty"
          ],
          "name" : {
            "content" : [
              {
                "lang" : "de",
                "text" : "Erweiterte Messunsicherheit"
              },
              {
                "lang" : "en",
                "text" : "Expanded uncertainty"
              }
            ]
          },
          "norms" : [
            "GUM"
          ],
          "description" : {
            "textContent" : {
              "content" : [
                {
                  "lang" : "de",
                  "text" : "Angegeben ist die erweiterte Messunsicherheit, die sich aus der\n              Standardmessunsicherheit durch Multiplikation mit dem Erweiterungsfaktor k = 2 ergibt. Sie wurde gemäß dem\n              \"Guide to the Expression of Uncertainty in Measurement (GUM)\" ermittelt. Der Wert der Messgröße liegt dann\n              im Regelfall mit einer Wahrscheinlichkeit von annähernd 95 % im zugeordneten Überdeckungsintervall.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The uncertainty stated is the expanded measurement uncertainty obtained by\n              multiplying the standard measurement uncertainty by the coverage factor k=2. It has been determined in\n              accordance with the “Guide to the Expression of Uncertainty in Measurement (GUM)”. The value of the\n              measurand then normally lies, with a probability of approximately 95%, within the attributed coverage\n              interval.\n            "
                }
              ]
            }
          }
        },
        {
          "refTypes" : [
            "gp_uncertainty"
          ],
          "name" : {
            "content" : [
              {
                "lang" : "de",
                "text" : "Messunsicherheit des Verfahrens"
              },
              {
                "lang" : "en",
                "text" : "Measurement uncertainity of the measurement procedure"
              }
            ]
          },
          "norms" : [
            "GUM"
          ],
          "description" : {
            "textContent" : {
              "content" : [
                {
                  "lang" : "de",
                  "text" : "Die Messunsicherheit der Abweichung des von der Anzeige des Gerätes abgelesenen\n              Wertes vom Referenzwert der relativen Feuchte ist in der Tabelle für die einzelnen Kalibrierpunkte\n              angegeben. Berücksichtigt wurden dabei Beiträge aus der Messung der Taupunkttemperatur, sowie der Messung\n              der Bezugstemperatur (Kalibrierung des Pt-100 sowie Temperaturinhomogenität der Klimakammer) und der\n              Kurzzeitstabilität des Kalibriergegenstandes während der Messung. Ein Beitrag für die Langzeitstabilität\n              oder des Hystereseverhaltens des Kalibriergegenstandes ist nicht berücksichtigt.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The measurement uncertainity of the difference of the read value from the display of\n              the device and the reference value of the relative humidity is given in the table for each single point of\n              calibration. Contribution due to the measurement of the dew point tmeperature, and the reference\n              temperature (calibration of the Pt-100 as well as inhomogeneity of the climatic chamber), and short term\n              stability of the device under calibration during the meausurement are considered. Contributions due to\n              long term stability or hysteresis of the device under test are not considered.\n            "
                }
              ]
            }
          }
        },
        {
          "refTypes" : [
            "gp_method"
          ],
          "name" : {
            "content" : [
              {
                "lang" : "de",
                "text" : "Kalibrierverfahren"
              },
              {
                "lang" : "en",
                "text" : "Calibration method"
              }
            ]
          },
          "norms" : [
            "DKD-R 5-8"
          ],
          "description" : {
            "textContent" : {
              "content" : [
                {
                  "lang" : "de",
                  "text" : "Die Feuchtekalibrierung wurde nach der DKD-Richtlinie DKD-R 5-8 „Kalibrierung von\n              Hygrometern zur direkten Erfassung der relativen Feuchte“, Ausgabe 02/2019 nach Ablauf A2\n              (aufwärts/abwärts) durchgeführt.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The humidity calibration was carried out according to the DKD guideline DKD-R 5-8\n              ʺCalibration of hygrometers for the direct measurement of relative humidityʺ, Edition 10/2019, in\n              accordance with sequence A2 (upward/downward).\n            "
                }
              ]
            }
          }
        },
        {
          "refTypes" : [
            "basic_measurementConditions"
          ],
          "name" : {
            "content" : [
              {
                "lang" : "de",
                "text" : "Messbedingungen"
              },
              {
                "lang" : "en",
                "text" : "Measurement conditions"
              }
            ]
          },
          "description" : {
            "textContent" : {
              "content" : [
                {
                  "lang" : "en",
                  "text" : "The calibration was carried out in a climatic chamber at a flow velocity of\n              approximately 2 m/s.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The calibration was carried out in air."
                },
                {
                  "lang" : "en",
                  "text" : "The external sensor of the calibration item was positioned in the climatic chamber,\n              including 1 m of its connecting cable. The display unit was exposed to room conditions outside the\n              measuring chamber during calibration.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The adjustment time for each calibration point was at least 150 min."
                },
                {
                  "lang" : "en",
                  "text" : "The starting value for the calibration was the specified environmental condition.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The value of the hysteresis is not considered in the measurement uncertainty.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The reference value of the relative humidity was calculated from the measured values\n              of the gas temperature and dew point temperature of the reference standards.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The given values of relative humidity refer to the saturation above water.\n            "
                },
                {
                  "lang" : "en",
                  "text" : "The measurement results are shown in order of the calibration."
                },
                {
                  "lang" : "de",
                  "text" : "Die Kalibrierung wurde in einem Klimaschrank bei einer Strömungsgeschwindigkeit von\n              ca. 2 m/s durchgeführt.\n              Die Kalibrierung wurde in Luft durchgeführt.\n              Der externe Fühler des Kalibriergegenstandes wurde inklusive 1 m seiner Anschlussleitung im Klimaschrank\n              positioniert. Das Anzeigegerät war während der Kalibrierung außerhalb der Messkammer den Raumbedingungen\n              ausgesetzt.\n              Die Angleichzeit für jeden Kalibrierpunkt betrug mindestens 150 min.\n              Der Startwert für die Kalibrierung war die angegebene Umgebungsbedingung.\n              Der Wert der Hysterese ist in der Messunsicherheit nicht berücksichtigt.\n              Der Referenzwert der relativen Feuchte wurde aus den Messwerten der Gastemperatur und Taupunkttemperatur\n              der Bezugsnormale berechnet.\n              Die angegebenen relativen Feuchtewerte beziehen sich auf die Sättigung über Wasser.\n              Angegeben sind die Messergebnisse in der Reihenfolge der Kalibrierung.\n            "
                }
              ]
            }
          },
          "norms" : [
            ""
          ]
        }
