      <dcc:usedMethods>
        <dcc:usedMethod refType="gp_method">
          <dcc:name>
            <dcc:content lang="de">Kalibrierverfahren</dcc:content>
            <dcc:content lang="en">Calibration method</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="en">The pressure measuring device was calibrated by means of a comparison with the
              pressure standards of the Physikalisch-Technische Bundesanstalt (PTB). The calibration sequence consisted
              of two measuring cycles (each with measuring series of increasing and decreasing pressure).
            </dcc:content>
            <dcc:content lang="en">According to DKD-guideline DKD-R 6-1 „Calibration of Pressure Gauges“, edition
              03/2014, revision 3 using calibration sequence(increasing/decreasing).
            </dcc:content>
            <dcc:content lang="de">Das Druckmessgerät wurde kalibriert durch einen Vergleich mit den Drucknormalen der
              Physikalisch-Technischen Bundesanstalt (PTB). Der Kalibrierablauf bestand aus zwei Messzyklen (jeweils
              Messreihen mit steigendem und fallendem Druck).
              Gemäß DKD-Richtlinie DKD-R 6-1 „Kalibrierung von Druckmessgeräten“, Ausgabe 03/2014, Revision 3 nach
              Ablauf A (aufwärts/abwärts) durchgeführt.
            </dcc:content>
          </dcc:description>
          <dcc:norm>DKD-R 6-1</dcc:norm>
          <dcc:reference>https://doi.org/10.7795/550.20201221</dcc:reference>
        </dcc:usedMethod>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Auf den Kalibriergegenstand abgestimmte Kalibrierbedinungen:</dcc:content>
            <dcc:content lang="en">Calibration conditions adapted to the calibration material:</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="en">Type of measureable pressures with the calibrated object: Absolute pressure
            </dcc:content>
            <dcc:content lang="en">Reference layer: middle of pressure connector</dcc:content>
            <dcc:content lang="en">Measured value output: Digital display</dcc:content>
            <dcc:content lang="en">Pressure-transmitting medium: Air</dcc:content>
            <dcc:content lang="en">Type: Desk instrument</dcc:content>
            <dcc:content lang="de">Art der mit dem Kalibriergegenstand messbaren Drücke: Absolutdruck
              Bezugsebene: Mitte des Druckanschlusses
              Messwertausgabe: Digitale Anzeige
              Druckübertragungsmedium: Luft
              Ausrichtung: Tischgerät
            </dcc:content>
          </dcc:description>
        </dcc:usedMethod>
        <dcc:usedMethod refType="basic_uncertainty">
          <dcc:name>
            <dcc:content lang="de">Erweiterte Messunsicherheit</dcc:content>
            <dcc:content lang="en">Expanded uncertainty</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Angegeben ist die erweiterte Messunsicherheit, die sich aus der
              Standardmessunsicherheit durch Multiplikation mit dem Erweiterungsfaktor k = 2 ergibt. Sie wurde gemäß dem
              "Guide to the Expression of Uncertainty in Measurement (GUM)" ermittelt. Der Wert der Messgröße liegt dann
              im Regelfall mit einer Wahrscheinlichkeit von annähernd 95 % im zugeordneten Überdeckungsintervall.
            </dcc:content>
            <dcc:content lang="en">The expanded measurement uncertainty is given, which results from the standard
              measurement uncertainty by multiplying it by the coverage factor k = 2. It was determined according to the
              "Guide to the Expression of Uncertainty in Measurement (GUM)". The value of the measurand is then usually
              within the assigned coverage interval with a probability of approximately 95%.
            </dcc:content>
          </dcc:description>
          <dcc:norm>GUM</dcc:norm>
        </dcc:usedMethod>
      </dcc:usedMethods>
